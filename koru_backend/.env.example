# -----------------------------------------------------------------------------
# Django core settings
# -----------------------------------------------------------------------------
# Secret key used by Django for cryptographic signing.
SECRET_KEY=your-django-secret-key-here

# Enables debug mode in development. Use False in production.
DEBUG=True

# Comma-separated list of domains/IPs allowed to serve this project.
ALLOWED_HOSTS=127.0.0.1,localhost

# Defines the current runtime environment.
# Suggested values: development or production
ENVIRONMENT=development


# -----------------------------------------------------------------------------
# PostgreSQL database settings
# -----------------------------------------------------------------------------
# Name of the PostgreSQL database.
DATABASE_NAME=koru_db

# PostgreSQL user name.
DATABASE_USER=postgres

# PostgreSQL user password.
DATABASE_PASSWORD=postgres

# PostgreSQL server host.
DATABASE_HOST=localhost

# PostgreSQL server port.
DATABASE_PORT=5432


# -----------------------------------------------------------------------------
# Redis / Celery settings
# -----------------------------------------------------------------------------
# Redis host used by Celery as broker/result backend.
REDIS_HOST=localhost

# Redis port used by Celery.
REDIS_PORT=6379

# Optional Redis database index.
REDIS_DB=0

# Redis database index dedicated to cache/throttling.
REDIS_CACHE_DB=1

# Optional explicit Redis URL for cache and rate limiting.
REDIS_CACHE_URL=redis://localhost:6379/1

# Optional explicit Celery broker URL.
# If omitted, the project can build it from REDIS_HOST/REDIS_PORT/REDIS_DB.
CELERY_BROKER_URL=redis://localhost:6379/0

# Optional explicit Celery result backend URL.
# If omitted, the project can build it from REDIS_HOST/REDIS_PORT/REDIS_DB.
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Access token lifetime in minutes.
KORU_JWT_ACCESS_TTL_MINUTES=15

# Refresh token lifetime in days.
KORU_JWT_REFRESH_TTL_DAYS=14

# Global API throttling rates.
API_BURST_RATE=60/minute
API_SUSTAINED_RATE=1000/day

# Authentication throttling rates.
AUTH_BURST_RATE=10/minute
AUTH_SUSTAINED_RATE=100/day

# Enables pgvector-backed semantic retrieval fields.
PGVECTOR_ENABLED=False

# Neo4j connection settings for the academic knowledge graph.
NEO4J_BOLT_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password


# -----------------------------------------------------------------------------
# OpenAI integration
# -----------------------------------------------------------------------------
# API key used to access OpenAI services.
OPENAI_API_KEY=your-openai-api-key-here

# GPT-4o snapshot used by KORU DeepScan structured analysis.
OPENAI_DEEPSCAN_MODEL=gpt-4o-2024-08-06


# -----------------------------------------------------------------------------
# Initial Django superuser
# -----------------------------------------------------------------------------
# Email used for the initial administrative account.
DJANGO_SUPERUSER_EMAIL=admin@koru.local

# Username used for the initial administrative account.
DJANGO_SUPERUSER_USERNAME=admin

# Password used for the initial administrative account.
DJANGO_SUPERUSER_PASSWORD=change-this-password

# Optional first name for the initial administrative account.
DJANGO_SUPERUSER_FIRST_NAME=KORU

# Optional last name for the initial administrative account.
DJANGO_SUPERUSER_LAST_NAME=Admin


# -----------------------------------------------------------------------------
# CORS and security settings
# -----------------------------------------------------------------------------
# Comma-separated list of origins allowed to access the API in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Forces HTTPS redirects in production.
SECURE_SSL_REDIRECT=False

# Marks session cookies as secure in production.
SESSION_COOKIE_SECURE=False

# Marks CSRF cookies as secure in production.
CSRF_COOKIE_SECURE=False

# HTTP Strict Transport Security duration in seconds.
SECURE_HSTS_SECONDS=0

# Enables HSTS for all subdomains.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Enables HSTS preload support.
SECURE_HSTS_PRELOAD=False

# Prevents MIME-type sniffing.
SECURE_CONTENT_TYPE_NOSNIFF=True
