# -----------------------------------------------------------------------------
# Django core settings
# -----------------------------------------------------------------------------
# Secret key used by Django for cryptographic signing.
SECRET_KEY=your-django-secret-key-here

# Enables debug mode in development. Use False in production.
DEBUG=True

# Comma-separated list of domains/IPs allowed to serve this project.
ALLOWED_HOSTS=127.0.0.1,localhost

# Defines the current runtime environment.
# Suggested values: development or production
ENVIRONMENT=development


# -----------------------------------------------------------------------------
# PostgreSQL database settings
# -----------------------------------------------------------------------------
# Name of the PostgreSQL database.
DATABASE_NAME=nexus_db

# PostgreSQL user name.
DATABASE_USER=postgres

# PostgreSQL user password.
DATABASE_PASSWORD=postgres

# PostgreSQL server host.
DATABASE_HOST=localhost

# PostgreSQL server port.
DATABASE_PORT=5432


# -----------------------------------------------------------------------------
# Redis / Celery settings
# -----------------------------------------------------------------------------
# Redis host used by Celery as broker/result backend.
REDIS_HOST=localhost

# Redis port used by Celery.
REDIS_PORT=6379

# Optional Redis database index.
REDIS_DB=0

# Optional explicit Celery broker URL.
# If omitted, the project can build it from REDIS_HOST/REDIS_PORT/REDIS_DB.
CELERY_BROKER_URL=redis://localhost:6379/0

# Optional explicit Celery result backend URL.
# If omitted, the project can build it from REDIS_HOST/REDIS_PORT/REDIS_DB.
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# OpenAI integration
# -----------------------------------------------------------------------------
# API key used to access OpenAI services.
OPENAI_API_KEY=your-openai-api-key-here


# -----------------------------------------------------------------------------
# Canvas LMS OAuth2 integration
# -----------------------------------------------------------------------------
# OAuth2 client ID for Canvas LMS integration.
CANVAS_CLIENT_ID=your-canvas-client-id

# OAuth2 client secret for Canvas LMS integration.
CANVAS_CLIENT_SECRET=your-canvas-client-secret

# Base URL of your Canvas LMS instance.
CANVAS_BASE_URL=https://your-school.instructure.com

# Redirect URI registered in Canvas for OAuth2 authentication.
CANVAS_REDIRECT_URI=http://localhost:8000/api/integrations/canvas/callback/


# -----------------------------------------------------------------------------
# CORS and security settings
# -----------------------------------------------------------------------------
# Comma-separated list of origins allowed to access the API in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Forces HTTPS redirects in production.
SECURE_SSL_REDIRECT=False

# Marks session cookies as secure in production.
SESSION_COOKIE_SECURE=False

# Marks CSRF cookies as secure in production.
CSRF_COOKIE_SECURE=False

# HTTP Strict Transport Security duration in seconds.
SECURE_HSTS_SECONDS=0

# Enables HSTS for all subdomains.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Enables HSTS preload support.
SECURE_HSTS_PRELOAD=False

# Prevents MIME-type sniffing.
SECURE_CONTENT_TYPE_NOSNIFF=True
